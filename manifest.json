{
	"manifest_version": 2,
	"name": "__MSG_extensionName__",
	"description": "__MSG_extensionDescription__",
	"version": "1.0.0",
	"author": "Joaquín Serna",
	"default_locale": "en",
	"applications": {
		"gecko": {
			"id": "export-to-zip@serna.ar",
			"strict_min_version": "78.4.0"
		}
	},
	"background": {
		"scripts": ["jszip.min.js", "index.js"]
	},
	"permissions": ["messagesRead", "accountsFolders", "accountsRead", "downloads", "menus"],
	"browser_action": {
		"default_title": "__MSG_extensionName__"
	}
}
